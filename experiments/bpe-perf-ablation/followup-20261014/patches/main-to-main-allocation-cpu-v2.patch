+static DIAG_NS: [std::sync::atomic::AtomicU64; 12] = [const { std::sync::atomic::AtomicU64::new(0) }; 12];
+static DIAG_CALLS: [std::sync::atomic::AtomicU64; 12] = [const { std::sync::atomic::AtomicU64::new(0) }; 12];
+fn diag(index: usize, begin: std::time::Instant) {
+ DIAG_ALLOC_PHASE.store(12, std::sync::atomic::Ordering::Relaxed);
+    use std::sync::atomic::Ordering::Relaxed;
+    DIAG_NS[index].fetch_add(begin.elapsed().as_nanos() as u64, Relaxed);
+    DIAG_CALLS[index].fetch_add(1, Relaxed);
+}
+fn diag_report() {
+ diagnostic_allocation_report();
+    use std::sync::atomic::Ordering::Relaxed;
+    let names = ["vocabulary", "plan", "initial_count", "materialize", "merge_rounds", "retire", "prepare", "apply", "commit", "select", "alphabet", "output"];
+    for (i, name) in names.iter().enumerate() {
+        eprintln!("BPE_PHASE {}", serde_json::json!({"phase":name, "seconds": DIAG_NS[i].load(Relaxed) as f64 / 1e9, "calls":DIAG_CALLS[i].load(Relaxed)}));
+    }
+}
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+static DIAG_ALLOC_PHASE: AtomicUsize = AtomicUsize::new(12);
+static DIAG_ALLOC_NEXT_THREAD: AtomicUsize = AtomicUsize::new(0);
+thread_local! { static DIAG_ALLOC_THREAD: std::cell::Cell<usize> = const {std::cell::Cell::new(usize::MAX)}; }
+#[repr(align(64))]
+struct DiagnosticAllocationCounter([std::sync::atomic::AtomicU64; 4]);
+static DIAG_ALLOC: [[DiagnosticAllocationCounter; 12]; 64] = [const { [const { DiagnosticAllocationCounter([const {std::sync::atomic::AtomicU64::new(0)};4]) };12] };64];
+struct DiagnosticAllocator;
+#[global_allocator]
+static DIAGNOSTIC_ALLOCATOR: DiagnosticAllocator = DiagnosticAllocator;
+fn diagnostic_allocation(calls: u64, bytes: u64, reallocs: u64, freed: u64) {
+    let phase = DIAG_ALLOC_PHASE.load(Ordering::Relaxed);
+    if phase >= 12 {return;}
+    DIAG_ALLOC_THREAD.with(|cell| {
+        let mut thread = cell.get();
+        if thread == usize::MAX {thread=DIAG_ALLOC_NEXT_THREAD.fetch_add(1,Ordering::Relaxed);cell.set(thread);}
+        if thread >= 64 {return;}
+        let counters = &DIAG_ALLOC[thread][phase].0;
+        for (counter,value) in counters.iter().zip([calls,bytes,reallocs,freed]) {
+            if value != 0 {counter.fetch_add(value,Ordering::Relaxed);}
+        }
+    });
+}
+unsafe impl std::alloc::GlobalAlloc for DiagnosticAllocator {
+    unsafe fn alloc(&self, layout: std::alloc::Layout) -> *mut u8 {
+        let sample=diagnostic_allocator_sample_start(0);
+        let p=unsafe {std::alloc::System.alloc(layout)};
+        diagnostic_allocator_sample_end(sample);
+        if !p.is_null() {diagnostic_allocation(1,layout.size() as u64,0,0);}
+        p
+    }
+    unsafe fn alloc_zeroed(&self, layout: std::alloc::Layout) -> *mut u8 {
+        let sample=diagnostic_allocator_sample_start(1);
+        let p=unsafe {std::alloc::System.alloc_zeroed(layout)};
+        diagnostic_allocator_sample_end(sample);
+        if !p.is_null() {diagnostic_allocation(1,layout.size() as u64,0,0);}
+        p
+    }
+    unsafe fn dealloc(&self,p:*mut u8,layout:std::alloc::Layout) {
+        diagnostic_allocation(0,0,0,layout.size() as u64);
+        let sample=diagnostic_allocator_sample_start(3);
+        unsafe {std::alloc::System.dealloc(p,layout)};
+        diagnostic_allocator_sample_end(sample);
+    }
+    unsafe fn realloc(&self,p:*mut u8,layout:std::alloc::Layout,size:usize)->*mut u8 {
+        let sample=diagnostic_allocator_sample_start(2);
+        let q=unsafe {std::alloc::System.realloc(p,layout,size)};
+        diagnostic_allocator_sample_end(sample);
+        if !q.is_null() {diagnostic_allocation(0,size as u64,1,layout.size() as u64);}
+        q
+    }
+}
+fn diag_start(index:usize)->std::time::Instant {
+    DIAG_ALLOC_PHASE.store(index,Ordering::Relaxed);
+    std::time::Instant::now()
+}
+fn diagnostic_allocation_report() {
+    DIAG_ALLOC_PHASE.store(12,Ordering::Relaxed);
+    diagnostic_allocator_time_report();
+    let names=["vocabulary","plan","initial_count","materialize","merge_rounds","retire","prepare","apply","commit","select","alphabet","output"];
+    for (phase,name) in names.iter().enumerate() {
+        let mut totals=[0u64;4];let mut threads=Vec::new();
+        for (i,thread) in DIAG_ALLOC.iter().enumerate() {
+            let values=thread[phase].0.each_ref().map(|v|v.load(Ordering::Relaxed));
+            for j in 0..4 {totals[j]+=values[j];}
+            if values.iter().any(|&v|v!=0) {threads.push(serde_json::json!({"thread":i,"values":values}));}
+        }
+        eprintln!("BPE_ALLOC {}",serde_json::json!({"phase":name,"alloc_calls":totals[0],"requested_bytes":totals[1],"realloc_calls":totals[2],"freed_bytes":totals[3],"threads":threads}));
+    }
+}
+
+#[repr(align(64))]
+struct DiagnosticAllocatorTiming([std::sync::atomic::AtomicU64; 6]);
+static DIAG_ALLOC_TIMES: [[[DiagnosticAllocatorTiming; 4]; 12]; 64] = [const { [const { [const {DiagnosticAllocatorTiming([const {std::sync::atomic::AtomicU64::new(0)};6])};4] };12] };64];
+static DIAG_CLOCK_NS: [std::sync::atomic::AtomicU64; 64] = [const {std::sync::atomic::AtomicU64::new(0)};64];
+thread_local! { static DIAG_TIMING_RANDOM: std::cell::Cell<u64> = const {std::cell::Cell::new(0x861a_9c74_4f1b_593d)}; }
+unsafe extern "C" { fn clock_gettime(clock: i32, output: *mut [i64;2]) -> i32; }
+fn diagnostic_allocator_clock() -> u64 {
+    let mut t=[0i64;2]; let status=unsafe {clock_gettime(3,&mut t)};
+    if status!=0 {std::process::abort();}
+    t[0] as u64*1_000_000_000+t[1] as u64
+}
+struct DiagnosticAllocatorSample {thread:usize, phase:usize, operation:usize, start:u64}
+fn diagnostic_allocator_sample_start(operation:usize) -> Option<DiagnosticAllocatorSample> {
+    let phase=DIAG_ALLOC_PHASE.load(Ordering::Relaxed);if phase>=12{return None;}
+    let thread=DIAG_ALLOC_THREAD.with(|cell|{let mut i=cell.get();if i==usize::MAX {i=DIAG_ALLOC_NEXT_THREAD.fetch_add(1,Ordering::Relaxed);cell.set(i);}i});
+    if thread>=64{return None;}
+    let counters=&DIAG_ALLOC_TIMES[thread][phase][operation].0;
+    counters[0].fetch_add(1,Ordering::Relaxed);
+    let selected=DIAG_TIMING_RANDOM.with(|cell|{let mut n=cell.get();n^=n<<13;n^=n>>7;n^=n<<17;cell.set(n);n&127==0});
+    if !selected{return None;}
+    if DIAG_CLOCK_NS[thread].load(Ordering::Relaxed)==0 {
+        let mut differences=[0u64;128];
+        for n in &mut differences {let a=diagnostic_allocator_clock();let b=diagnostic_allocator_clock();*n=b-a;}
+        differences.sort_unstable();
+        DIAG_CLOCK_NS[thread].store(differences[64].max(1),Ordering::Relaxed);
+    }
+    Some(DiagnosticAllocatorSample{thread,phase,operation,start:diagnostic_allocator_clock()})
+}
+fn diagnostic_allocator_sample_end(sample:Option<DiagnosticAllocatorSample>) {
+    let Some(sample)=sample else{return;};
+    let elapsed=diagnostic_allocator_clock()-sample.start;
+    let empty_begin=diagnostic_allocator_clock();
+    std::hint::black_box(sample.operation);
+    let empty_elapsed=diagnostic_allocator_clock()-empty_begin;
+    let c=&DIAG_ALLOC_TIMES[sample.thread][sample.phase][sample.operation].0;
+    c[1].fetch_add(1,Ordering::Relaxed);c[2].fetch_add(elapsed,Ordering::Relaxed);
+    let sq=f64::from_bits(c[3].load(Ordering::Relaxed))+(elapsed as f64).powi(2);
+    c[3].store(sq.to_bits(),Ordering::Relaxed);c[4].fetch_max(elapsed,Ordering::Relaxed);c[5].fetch_add(empty_elapsed,Ordering::Relaxed);
+}
+fn diagnostic_allocator_time_report() {
+    let phases=["vocabulary","plan","initial_count","materialize","merge_rounds","retire","prepare","apply","commit","select","alphabet","output"];
+    for (phase,name) in phases.iter().enumerate() {
+        let mut rows=Vec::new();let mut raw=0.0;let mut corrected=0.0;
+        for thread in 0..64 {for (operation,op) in ["alloc","alloc_zeroed","realloc","dealloc"].iter().enumerate() {
+            let c=DIAG_ALLOC_TIMES[thread][phase][operation].0.each_ref().map(|x|x.load(Ordering::Relaxed));
+            if c[0]==0 {continue;}
+            let baseline=DIAG_CLOCK_NS[thread].load(Ordering::Relaxed);
+            let estimated_ns=if c[1]>0 {c[2] as f64/c[1] as f64*c[0] as f64}else{0.0};
+            let corrected_ns=if c[1]>0 {((c[2] as f64-c[5] as f64)/c[1] as f64).max(0.0)*c[0] as f64}else{0.0};
+            raw+=estimated_ns;corrected+=corrected_ns;
+            rows.push(serde_json::json!({"thread":thread,"operation":op,"calls":c[0],"sample_count":c[1],"sample_cpu_ns":c[2],"sample_squared_cpu_ns":f64::from_bits(c[3]),"max_sample_cpu_ns":c[4],"empty_clock_pair_median_ns":baseline,"paired_empty_clock_cpu_ns":c[5],"paired_empty_clock_mean_ns":if c[1]>0 {c[5] as f64/c[1] as f64}else{0.0},"estimated_raw_cpu_seconds":estimated_ns/1e9,"estimated_clock_corrected_cpu_seconds":corrected_ns/1e9}));
+        }}
+        eprintln!("BPE_ALLOC_CPU {}",serde_json::json!({"phase":name,"sampling_probability":"1/128 xorshift64 per thread","estimated_raw_cpu_seconds":raw/1e9,"estimated_clock_corrected_cpu_seconds":corrected/1e9,"rows":rows}));
+    }
+}
