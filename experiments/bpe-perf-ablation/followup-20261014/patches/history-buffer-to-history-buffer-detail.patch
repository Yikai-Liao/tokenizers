+mod fine_diag {
+    use std::{sync::atomic::{AtomicU64, Ordering::Relaxed}, time::Instant};
+    static WALL: [AtomicU64; 20] = [const { AtomicU64::new(0) }; 20];
+    static CPU: [AtomicU64; 20] = [const { AtomicU64::new(0) }; 20];
+    static CALLS: [AtomicU64; 20] = [const { AtomicU64::new(0) }; 20];
+    unsafe extern "C" { fn clock_gettime(clock: i32, time: *mut [i64; 2]) -> i32; }
+    fn cpu() -> u64 { let mut t = [0i64; 2]; unsafe { clock_gettime(3, &mut t); } (t[0] as u64)*1_000_000_000 + t[1] as u64 }
+    pub(super) struct Timer { tag: usize, wall: Instant, cpu: u64 }
+    pub(super) fn timer(tag: usize) -> Timer { Timer { tag, wall: Instant::now(), cpu: cpu() } }
+    impl Drop for Timer { fn drop(&mut self) { WALL[self.tag].fetch_add(self.wall.elapsed().as_nanos() as u64, Relaxed); CPU[self.tag].fetch_add(cpu()-self.cpu, Relaxed); CALLS[self.tag].fetch_add(1, Relaxed); } }
+    static COUNTS: [AtomicU64; 16] = [const { AtomicU64::new(0) }; 16];
+    pub(super) fn counts(values: [u64; 16]) { for (i, v) in values.into_iter().enumerate() { COUNTS[i].fetch_add(v, Relaxed); } }
+    pub(super) fn report() { eprintln!("BPE_WORK {}", serde_json::json!({"counters": COUNTS.iter().map(|x|x.load(Relaxed)).collect::<Vec<_>>() })); let names = ["commit_route", "commit_owner_join", "commit_global_publish", "owner_actions", "owner_sort", "owner_reduce_publish", "prepare_setup", "prepare_scan", "prepare_finish", "apply_total", "commit_total", "main_completed_publish", "main_owner_reduce", "vocabulary_plan", "initial_count", "materialize", "retire", "output", "select", "prepare_total"]; for i in 0..20 { if CALLS[i].load(Relaxed)>0 { eprintln!("BPE_FINE {}", serde_json::json!({"phase": names[i], "wall_seconds_sum":WALL[i].load(Relaxed) as f64/1e9, "thread_cpu_seconds_sum":CPU[i].load(Relaxed) as f64/1e9, "calls":CALLS[i].load(Relaxed)})); } } }
