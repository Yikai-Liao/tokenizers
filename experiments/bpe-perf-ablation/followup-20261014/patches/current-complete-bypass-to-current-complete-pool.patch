     fn do_train_impl(&self, words: WordCountsView<'_>) -> Result<Vocabulary> {
+        // Keep round coordination on the ambient pool's worker, so each joined
+        // phase does not enter that pool again from the calling thread.
+        if get_parallelism() && rayon::current_thread_index().is_none() {
+            rayon::join(|| self.train_attempts(words), || ()).0
+        } else {
+            self.train_attempts(words)
+        }
