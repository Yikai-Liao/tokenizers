+thread_local! {static DIAG_ALLOC_SITE: std::cell::Cell<usize> = const {std::cell::Cell::new(6)};}
+fn diagnostic_allocation_phase() -> usize {
+    let phase=DIAG_ALLOC_PHASE.load(Ordering::Relaxed);
+    if phase>=12 {return usize::MAX;}
+    if phase==6 {DIAG_ALLOC_SITE.with(|s|s.get())} else {phase}
+}
+fn diagnostic_allocation_site<R>(site:usize,f:impl FnOnce()->R)->R {
+    let prior=DIAG_ALLOC_SITE.with(|s|s.replace(site));
+    let result=f();
+    DIAG_ALLOC_SITE.with(|s|s.set(prior));
+    result
+}
