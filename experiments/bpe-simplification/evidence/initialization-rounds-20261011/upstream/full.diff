+                let plan = CorpusPlan::build(view, ids, &trainer, false).unwrap();
+                let mut index = PairIndex::build(&plan, 1, workers, false, &progress).unwrap();
+                let mut corpus = plan.materialize();
+                let MergeOutcome::Committed(records) = trainer
