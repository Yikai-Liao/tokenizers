new file mode 100644
index 00000000..267c859b
--- /dev/null
+++ b/tokenizers/tk-train/src/trainers/bpe/engine/initial_review.rs
@@ -0,0 +1,29 @@
+
+use std::time::Instant;
+#[repr(C)]
+struct Timespec { sec: std::os::raw::c_long, nano: std::os::raw::c_long }
+unsafe extern "C" { fn clock_gettime(clock: i32, time: *mut Timespec) -> i32; }
+fn cpu_ns() -> u64 {
+    let mut time = Timespec { sec: 0, nano: 0 };
+    assert_eq!(unsafe { clock_gettime(2, &mut time) }, 0);
+    time.sec as u64 * 1_000_000_000 + time.nano as u64
+}
+fn resident() -> (u64,u64) {
+    let text=std::fs::read_to_string("/proc/self/status").unwrap();
+    let field=|name: &str| text.lines().find(|l|l.starts_with(name)).unwrap().split_whitespace().nth(1).unwrap().parse().unwrap();
+    (field("VmRSS:"),field("VmHWM:"))
+}
+pub(super) struct Stage { name: &'static str, wall: Instant, cpu: u64, rss: u64, hwm: u64 }
+pub(super) fn stage(name: &'static str) -> Stage {
+    let (rss,hwm)=resident();
+    eprintln!("BPE_INIT_BEGIN {{\"name\":\"{}\",\"rss_kib\":{},\"hwm_kib\":{}}}",name,rss,hwm);
+    Stage {name,wall:Instant::now(),cpu:cpu_ns(),rss,hwm}
+}
+impl Drop for Stage {
+    fn drop(&mut self) {
+        let cpu=cpu_ns()-self.cpu;
+        let wall=self.wall.elapsed().as_secs_f64();
+        let (rss,hwm)=resident();
+        eprintln!("BPE_INIT_END {{\"name\":\"{}\",\"wall_seconds\":{},\"cpu_seconds\":{},\"rss_before_kib\":{},\"hwm_before_kib\":{},\"rss_end_kib\":{},\"hwm_end_kib\":{}}}",self.name,wall,cpu as f64/1e9,self.rss,self.hwm,rss,hwm);
+    }
+}
