diff --git a/tokenizers/tk-train/src/trainers/bpe/engine/initial_experiment.rs b/tokenizers/tk-train/src/trainers/bpe/engine/initial_experiment.rs
new file mode 100644
index 00000000..028ec3e3
--- /dev/null
+++ b/tokenizers/tk-train/src/trainers/bpe/engine/initial_experiment.rs
@@ -0,0 +1,164 @@
+//! Controlled experimental factors; never used without an explicit mode.
+use super::*;
+use std::ops::Range;
+
+type RawPiece = Vec<(Pair, State<Builder>)>;
+type FrozenPiece<'a> = Vec<(Pair, State<Positions<'a>>)>;
+
+fn collect(
+    corpus: &CorpusPlan<'_>,
+    range: Range<usize>,
+    work: &crate::progress::WorkProgress,
+) -> Result<RawPiece> {
+    let domain = corpus.small_pair_domain();
+    let mut dense: Vec<State<Builder>> = (0..domain.map_or(0, |n| n * n))
+        .map(|_| State::default())
+        .collect();
+    let mut counts = AHashMap::<Pair, State<Builder>>::new();
+    corpus.initial_edges(range.clone(), |pair, p, weight| {
+        debug_assert!(pair.0 != WORD_SEPARATOR_ID && pair.1 != WORD_SEPARATOR_ID);
+        let state = match domain {
+            Some(n) => &mut dense[pair.0 as usize * n + pair.1 as usize],
+            None => counts.entry(pair).or_default(),
+        };
+        add(&mut state.count, weight)?;
+        state.positions.push(p)
+    })?;
+    work.complete(range.len());
+    Ok(match domain {
+        Some(n) => dense
+            .into_iter()
+            .enumerate()
+            .filter(|(_, s)| !s.positions.is_empty())
+            .map(|(key, state)| (((key / n) as u32, (key % n) as u32), state))
+            .collect(),
+        None => counts.into_iter().collect(),
+    })
+}
+
+fn freeze<'a>(piece: RawPiece, arena: &'a Arena) -> Result<FrozenPiece<'a>> {
+    let mut lease = arena.lease();
+    piece
+        .into_iter()
+        .map(|(pair, state)| {
+            // Temporary fragments must be reclaimable, including short heap lists.
+            // Keeping them in the training bump arena would retain obsolete copies.
+            let positions =
+                Positions::from_sorted_owned(Input::Builder(&state.positions), &mut lease)?;
+            Ok((
+                pair,
+                State {
+                    count: state.count,
+                    positions,
+                },
+            ))
+        })
+        .collect()
+}
+
+pub(super) fn build<'a>(
+    arena: &'a Arena,
+    corpus: &CorpusPlan<'_>,
+    minimum: u64,
+    workers: usize,
+    reuse: bool,
+    progress: &TrainingProgress,
+    mode: &str,
+) -> Result<Vec<Shard<'a>>> {
+    let (online, waves) = match mode {
+        "raw-all" => (false, false),
+        "online-all" => (true, false),
+        "raw-wave" => (false, true),
+        "online-wave" => (true, true),
+        _ => return Err("unknown initial experiment mode".into()),
+    };
+    let cap = std::env::var("BPE_INITIAL_BLOCK_SLOTS")
+        .ok()
+        .map(|s| s.parse::<usize>())
+        .transpose()?
+        .unwrap_or(1 << 24);
+    if cap == 0 {
+        return Err("initial block cap must be positive".into());
+    }
+    let ranges = corpus.initial_ranges(cap);
+    let batch = if waves { workers } else { ranges.len().max(1) };
+    if std::env::var_os("BPE_INITIAL_DIAGNOSTIC").is_some() {
+        eprintln!(
+            "BPE_INITIAL_GEOMETRY {{\"mode\":\"{}\",\"blocks\":{},\"waves\":{},\"block_slot_cap\":{},\"max_block_slots\":{},\"max_block_words\":{}}}",
+            mode,
+            ranges.len(),
+            ranges.len().div_ceil(batch),
+            cap,
+            ranges
+                .iter()
+                .map(|r| corpus.range_slots(r))
+                .max()
+                .unwrap_or(0),
+            ranges.iter().map(|r| r.len()).max().unwrap_or(0)
+        );
+    }
+    let work = progress.stage("Count initial pairs", corpus.word_count());
+    let mut pieces = Vec::new();
+    for wave in ranges.chunks(batch) {
+        let frozen = if online {
+            wave.par_iter()
+                .map(|range| freeze(collect(corpus, range.clone(), &work)?, arena))
+                .collect::<Result<Vec<_>>>()?
+        } else {
+            // The barrier is the only difference: all raw blocks in this batch
+            // remain live until collection joins, then the same freeze runs.
+            wave.par_iter()
+                .map(|range| collect(corpus, range.clone(), &work))
+                .collect::<Result<Vec<_>>>()?
+                .into_par_iter()
+                .map(|piece| freeze(piece, arena))
+                .collect::<Result<Vec<_>>>()?
+        };
+        pieces.extend(frozen);
+    }
+    let mut routed: Vec<Vec<_>> = (0..workers).map(|_| Vec::new()).collect();
+    for piece in pieces {
+        for (pair, state) in piece {
+            routed[owner(pair, workers)].push((pair, state));
+        }
+    }
+    routed
+        .into_par_iter()
+        .map(|pieces| {
+            let mut states = AHashMap::<Pair, State<Vec<Positions>>>::new();
+            for (pair, state) in pieces {
+                let total = states.entry(pair).or_default();
+                add(&mut total.count, state.count)?;
+                total.positions.push(state.positions);
+            }
+            let mut lease = arena.lease();
+            let mut shard = Shard::default();
+            for (pair, mut state) in states {
+                // Floor/reuse admission is global, never decided per fragment.
+                if reuse || state.count >= minimum.max(1) {
+                    let positions = if state.positions.len() == 1 {
+                        state.positions.pop().unwrap()
+                    } else {
+                        Positions::from_sorted(Input::Fragments(&state.positions), &mut lease)?
+                    };
+                    shard.states.insert(
+                        pair,
+                        State {
+                            count: state.count,
+                            positions,
+                        },
+                    );
+                }
+            }
+            if !reuse {
+                shard
+                    .queue
+                    .extend(shard.states.iter().map(|(&pair, state)| Priority {
+                        pair: Reverse(pair),
+                        count: state.count,
+                    }));
+            }
+            Ok(shard)
+        })
+        .collect()
+}
