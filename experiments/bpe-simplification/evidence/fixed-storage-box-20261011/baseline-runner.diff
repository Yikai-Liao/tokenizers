+
+pub fn rss() -> Result<u64, Error> {
+    Ok(std::fs::read_to_string("/proc/self/status")?
+        .lines()
+        .find(|line| line.starts_with("VmRSS:"))
+        .and_then(|line| line.split_whitespace().nth(1))
+        .ok_or("missing RSS")?
+        .parse()?)
+}
+
+pub fn faults() -> Result<(i64, i64), Error> {
+    let mut usage = std::mem::MaybeUninit::<libc::rusage>::uninit();
+    // SAFETY: successful getrusage initializes this writable rusage structure.
+    if unsafe { libc::getrusage(libc::RUSAGE_SELF, usage.as_mut_ptr()) } != 0 {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    let usage = unsafe { usage.assume_init() };
+    Ok((usage.ru_minflt, usage.ru_majflt))
+}
