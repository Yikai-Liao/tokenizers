index 00000000..e246cd6e
--- /dev/null
+++ b/tokenizers/tk-train/src/trainers/bpe/engine/phase_timing.rs
@@ -0,0 +1,48 @@
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+const NAMES: [&str; 10] = ["vocabulary", "corpus_plan", "initial_index", "materialize", "select", "prepare", "apply", "commit", "release", "model_output"];
+static WALL: [AtomicU64; 10] = [const { AtomicU64::new(0) }; 10];
+static CPU: [AtomicU64; 10] = [const { AtomicU64::new(0) }; 10];
+static CALLS: [AtomicU64; 10] = [const { AtomicU64::new(0) }; 10];
+#[repr(C)]
+struct Timespec { sec: std::os::raw::c_long, nano: std::os::raw::c_long }
+unsafe extern "C" { fn clock_gettime(clock: i32, time: *mut Timespec) -> i32; }
+fn cpu_ns() -> u64 {
+    let mut time = Timespec { sec: 0, nano: 0 };
+    // Linux CLOCK_PROCESS_CPUTIME_ID; this host-only diagnostic owns the output.
+    assert_eq!(unsafe { clock_gettime(2, &mut time) }, 0);
+    time.sec as u64 * 1_000_000_000 + time.nano as u64
+}
+static RSS_BEGIN: [AtomicU64; 10] = [const { AtomicU64::new(0) }; 10];
+static RSS_END: [AtomicU64; 10] = [const { AtomicU64::new(0) }; 10];
+static NEW_HWM: [AtomicU64; 10] = [const { AtomicU64::new(0) }; 10];
+fn resident() -> (u64,u64) {
+    let text=std::fs::read_to_string("/proc/self/status").unwrap();
+    let field=|name: &str| text.lines().find(|l|l.starts_with(name)).unwrap().split_whitespace().nth(1).unwrap().parse().unwrap();
+    (field("VmRSS:"),field("VmHWM:"))
+}
+pub(super) struct Stage { index: usize, wall: Instant, cpu: u64, hwm: u64 }
+pub(super) fn stage(index: usize) -> Stage { { let (rss,hwm)=resident(); RSS_BEGIN[index].fetch_max(rss,Ordering::Relaxed); Stage { index, wall: Instant::now(), cpu: cpu_ns(), hwm } } }
+impl Drop for Stage {
+    fn drop(&mut self) {
+        let cpu = cpu_ns() - self.cpu;
+        WALL[self.index].fetch_add(self.wall.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        CPU[self.index].fetch_add(cpu, Ordering::Relaxed);
+        CALLS[self.index].fetch_add(1, Ordering::Relaxed);
+        let (rss,hwm)=resident();
+        RSS_END[self.index].fetch_max(rss,Ordering::Relaxed);
+        if hwm>self.hwm { NEW_HWM[self.index].fetch_max(hwm,Ordering::Relaxed); }
+    }
+}
+pub(super) struct Report;
+impl Drop for Report {
+    fn drop(&mut self) {
+        let rows: Vec<_> = NAMES.iter().enumerate().map(|(i, name)| format!(
+            r#"{{"name":"{}","wall_seconds":{},"cpu_seconds":{},"calls":{},"max_begin_rss_kib":{},"max_end_rss_kib":{},"new_process_hwm_kib":{}}}"#,
+            name, WALL[i].load(Ordering::Relaxed) as f64 / 1e9,
+            CPU[i].load(Ordering::Relaxed) as f64 / 1e9, CALLS[i].load(Ordering::Relaxed), RSS_BEGIN[i].load(Ordering::Relaxed), RSS_END[i].load(Ordering::Relaxed), NEW_HWM[i].load(Ordering::Relaxed)
+        )).collect();
+        eprintln!("BPE_PHASES {{\"stages\":[{}]}}", rows.join(","));
+    }
+}
