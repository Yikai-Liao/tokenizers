[
  {
    "name": "default-tests",
    "command": [
      "cargo",
      "test",
      "--offline",
      "--locked",
      "--manifest-path",
      "tokenizers/tk-train/Cargo.toml",
      "--lib",
      "--",
      "--skip",
      "feed_training_tokenizer_json_and_encoding_roundtrip"
    ],
    "exit_code": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--offline",
      "--locked",
      "--manifest-path",
      "tokenizers/tk-train/Cargo.toml",
      "--no-default-features",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "name": "codec",
    "command": [
      "cargo",
      "test",
      "--offline",
      "--locked",
      "--manifest-path",
      "experiments/bpe-simplification/miri-codec/Cargo.toml"
    ],
    "exit_code": 0
  },
  {
    "name": "format",
    "command": [
      "uv",
      "run",
      "experiments/bpe-simplification/format-changed.py",
      "--check",
      "tokenizers/tk-train/src/trainers/bpe/positions.rs"
    ],
    "exit_code": 0
  },
  {
    "name": "whitespace",
    "command": [
      "git",
      "diff",
      "--check"
    ],
    "exit_code": 0
  }
]