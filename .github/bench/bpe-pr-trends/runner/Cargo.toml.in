[package]
name = "bpe-bench-runner"
version = "0.1.0"
edition = "2024"

[dependencies]
tk-train = { path = "@SOURCE@/tokenizers/tk-train", default-features = false, features = ["bpe"] }
tk-encode = { path = "@SOURCE@/tokenizers/tk-encode", default-features = false, features = ["bpe", "parallelism", "normalizers"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
libc = "0.2"

[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1
