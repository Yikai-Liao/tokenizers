+// Diagnostic only: each dedicated training worker owns an arena. All posting
+// buffers survive through the training call, including retired buffers. The
+// caller releases arenas only after train_typed returns and every posting
+// owner has been dropped. The pool is alive throughout all pointer access.
+#[derive(Default)]
+struct PostingArena {
+    bump: bumpalo::Bump,
+    allocations: u64,
+    requested_bytes: u64,
+    grows: u64,
+    system_allocations: u64,
+    system_requested_bytes: u64,
+    system_frees: u64,
+    system_freed_bytes: u64,
+}
+static ARENA_LIMIT: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(usize::MAX);
+pub(super) fn arena_configure(limit: usize) {
+    ARENA_LIMIT.store(limit, std::sync::atomic::Ordering::Relaxed);
+}
+pub(super) fn arena_cutoff() -> usize { ARENA_LIMIT.load(std::sync::atomic::Ordering::Relaxed) }
+fn arena_owns(bytes: usize) -> bool {
+    bytes <= ARENA_LIMIT.load(std::sync::atomic::Ordering::Relaxed)
+}
+pub(super) fn phase_memory() -> serde_json::Value {
+    let text = std::fs::read_to_string("/proc/self/status").unwrap();
+    let mut result = serde_json::Map::new();
+    for line in text.lines() {
+        if line.starts_with("VmRSS:") || line.starts_with("VmHWM:") || line.starts_with("VmSwap:") {
+            let (key,value) = line.split_once(':').unwrap();
+            result.insert(key.to_owned(), serde_json::json!(value.split_whitespace().next().unwrap().parse::<u64>().unwrap()*1024));
+        }
+    }
+    serde_json::Value::Object(result)
+}
+thread_local! {
+    static POSTING_ARENA: std::cell::RefCell<PostingArena> =
+        std::cell::RefCell::new(PostingArena::default());
+}
+fn arena_allocate<T>(capacity: usize, growth: bool) -> Result<*mut T> {
+    let layout = std::alloc::Layout::array::<T>(capacity)
+        .map_err(|_| "posting arena layout overflow")?;
+    POSTING_ARENA.with(|cell| {
+        let mut arena = cell.borrow_mut();
+        if !arena_owns(layout.size()) {
+            // SAFETY: nonzero checked layout, global allocator origin matches
+            // the Vec::from_raw_parts release path below. No initialized value
+            // is exposed until the caller fills the reserved prefix.
+            let pointer = unsafe { std::alloc::alloc(layout) };
+            if pointer.is_null() { return Err("system posting allocation failed".into()); }
+            arena.system_allocations += 1;
+            arena.system_requested_bytes += layout.size() as u64;
+            arena.grows += u64::from(growth);
+            return Ok(pointer.cast::<T>());
+        }
+        let pointer = arena.bump.try_alloc_layout(layout)
+            .map_err(|_| "posting arena allocation failed")?;
+        arena.allocations += 1;
+        arena.requested_bytes += layout.size() as u64;
+        arena.grows += u64::from(growth);
+        Ok(pointer.as_ptr().cast::<T>())
+    })
+}
+pub(super) fn arena_snapshot() -> serde_json::Value {
+    POSTING_ARENA.with(|cell| {
+        let mut arena = cell.borrow_mut();
+        let chunks = arena.bump.iter_allocated_chunks().count();
+        serde_json::json!({
+            "allocations": arena.allocations,
+            "requested_bytes": arena.requested_bytes,
+            "grows": arena.grows,
+            "system_allocations":arena.system_allocations,
+            "system_requested_bytes":arena.system_requested_bytes,
+            "system_frees":arena.system_frees,
+            "system_freed_bytes":arena.system_freed_bytes,
+            "backing_bytes": arena.bump.allocated_bytes(),
+            "backing_bytes_including_metadata": arena.bump.allocated_bytes_including_metadata(),
+            "chunks": chunks
+        })
+    })
+}
+pub(super) fn arena_release() {
+    POSTING_ARENA.with(|cell| {
+        let old = std::mem::take(&mut *cell.borrow_mut());
+        drop(old);
+    });
+}
