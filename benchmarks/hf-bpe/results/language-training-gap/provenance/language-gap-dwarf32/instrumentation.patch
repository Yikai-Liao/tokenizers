+impl Options {
+    pub(super) fn from_bench_env() -> Self {
+        let mut options = Self::default();
+        let disabled = std::env::var("HF_BPE_COHORT_DISABLE").unwrap_or_default();
+        for name in disabled.split(',').map(str::trim).filter(|name| !name.is_empty()) {
+            match name {
+                "all" => return Self { sort_weights: false,
+            narrow_corpus: false,
+            weight_lookup: false,
+            initial_grouped: false,
+            parallel_apply: false,
+            grouped_tail: false,
+            scratch_cache: false,
+            character_cache: false,
+            packed_queue: false,
+            parallel_measure: false,
+            guarded_fast: false,
+            parallel_alphabet: false,
+            arena_allocator: false,
+            batch_execution: false,
+            queue_prefetch: false,
+            fused_batch: false },
+                "sort_weights" => options.sort_weights = false,
+                "narrow_corpus" => options.narrow_corpus = false,
+                "weight_lookup" => options.weight_lookup = false,
+                "initial_grouped" => options.initial_grouped = false,
+                "parallel_apply" => options.parallel_apply = false,
+                "grouped_tail" => options.grouped_tail = false,
+                "scratch_cache" => options.scratch_cache = false,
+                "character_cache" => options.character_cache = false,
+                "packed_queue" => options.packed_queue = false,
+                "parallel_measure" => options.parallel_measure = false,
+                "guarded_fast" => options.guarded_fast = false,
+                "parallel_alphabet" => options.parallel_alphabet = false,
+                "arena_allocator" => options.arena_allocator = false,
+                "batch_execution" => options.batch_execution = false,
+                "queue_prefetch" => options.queue_prefetch = false,
+                "fused_batch" => options.fused_batch = false,
+                other => panic!("unknown HF_BPE_COHORT_DISABLE option: {other}"),
+            }
+        }
+        options
+    }
+}
