+//! Intrusive diagnostic counters. These are never used for runtime ranking.
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering::Relaxed};
+use serde_json::{json, Value};
+
+pub(crate) const BINS: usize = 14;
+pub(crate) const BOUNDS: [u32; BINS] = [4,8,16,32,64,128,256,512,1024,2048,4096,16384,65536,u32::MAX];
+const AGE_BINS: usize = 17;
+static LIVE_BYTES: AtomicU64 = AtomicU64::new(0);
+static LIVE_PEAK: AtomicU64 = AtomicU64::new(0);
+static ROUND: AtomicU32 = AtomicU32::new(0);
+static FINISHED: AtomicBool = AtomicBool::new(false);
+static ALLOC_COUNT: [AtomicU64; BINS] = [const {AtomicU64::new(0)}; BINS];
+static ALLOC_BYTES: [AtomicU64; BINS] = [const {AtomicU64::new(0)}; BINS];
+static FREE_COUNT: [AtomicU64; BINS] = [const {AtomicU64::new(0)}; BINS];
+static FREE_BYTES: [AtomicU64; BINS] = [const {AtomicU64::new(0)}; BINS];
+static POLICY_CURRENT: [AtomicU64; BINS] = [const {AtomicU64::new(0)}; BINS];
+static POLICY_PEAK: [AtomicU64; BINS] = [const {AtomicU64::new(0)}; BINS];
+static RETIRED_AGES: [AtomicU64; BINS * AGE_BINS] = [const {AtomicU64::new(0)}; BINS * AGE_BINS];
+static RETIRED_BYTE_AGES: [AtomicU64; BINS * AGE_BINS] = [const {AtomicU64::new(0)}; BINS * AGE_BINS];
+static CHOSEN_BYTES: [AtomicU64; BINS] = [const {AtomicU64::new(0)}; BINS];
+static FLOOR_BYTES: [AtomicU64; BINS] = [const {AtomicU64::new(0)}; BINS];
+static BIRTH_SLOTS: AtomicU64 = AtomicU64::new(0);
+static REWRITES: AtomicU64 = AtomicU64::new(0);
+static GROWS: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn round() -> u32 { ROUND.load(Relaxed) }
+pub(crate) fn set_round(rules: usize) { ROUND.store(rules as u32, Relaxed); }
+pub(crate) fn finish() { FINISHED.store(true, Relaxed); }
+pub(crate) fn birth_slots(count: u32) { BIRTH_SLOTS.fetch_add(count as u64, Relaxed); }
+pub(crate) fn rewrites(count: usize) { REWRITES.fetch_add(count as u64, Relaxed); }
+pub(crate) fn grew() { GROWS.fetch_add(1, Relaxed); }
+pub(crate) fn class(capacity: u32) -> usize {
+    BOUNDS.iter().position(|&bound| capacity <= bound).unwrap()
+}
+pub(crate) fn age_bin(age: u32) -> usize {
+    if age == 0 { 0 } else { (32 - age.leading_zeros()) as usize }.min(AGE_BINS - 1)
+}
+pub(crate) fn allocated(capacity: u32, element_bytes: usize) -> u32 {
+    let i = class(capacity);
+    let bytes = capacity as u64 * element_bytes as u64;
+    let live = LIVE_BYTES.fetch_add(bytes, Relaxed) + bytes;
+    LIVE_PEAK.fetch_max(live, Relaxed);
+    ALLOC_COUNT[i].fetch_add(1, Relaxed);
+    ALLOC_BYTES[i].fetch_add(bytes, Relaxed);
+    for j in 0..BINS {
+        let current = POLICY_CURRENT[j].fetch_add(bytes, Relaxed) + bytes;
+        POLICY_PEAK[j].fetch_max(current, Relaxed);
+    }
+    round()
+}
+pub(crate) fn retired(capacity: u32, element_bytes: usize, born: u32, reason: u8) {
+    if FINISHED.load(Relaxed) { return; } // terminal survivors are censored
+    let i = class(capacity);
+    let bytes = capacity as u64 * element_bytes as u64;
+    LIVE_BYTES.fetch_sub(bytes, Relaxed);
+    FREE_COUNT[i].fetch_add(1, Relaxed);
+    FREE_BYTES[i].fetch_add(bytes, Relaxed);
+    let age = age_bin(round().saturating_sub(born));
+    RETIRED_AGES[i*AGE_BINS+age].fetch_add(1, Relaxed);
+    RETIRED_BYTE_AGES[i*AGE_BINS+age].fetch_add(bytes, Relaxed);
+    if reason == 1 { CHOSEN_BYTES[i].fetch_add(bytes, Relaxed); }
+    if reason == 2 { FLOOR_BYTES[i].fetch_add(bytes, Relaxed); }
+    // Policy j retains classes <=j in arena, frees all larger classes normally.
+    for j in 0..i { POLICY_CURRENT[j].fetch_sub(bytes, Relaxed); }
+}
+fn values<const N: usize>(a: &[AtomicU64; N]) -> Vec<u64> {
+    a.iter().map(|x|x.load(Relaxed)).collect()
+}
+pub(crate) fn memory() -> Value {
+    let text = std::fs::read_to_string("/proc/self/status").unwrap();
+    let mut result = serde_json::Map::new();
+    for line in text.lines() {
+        if line.starts_with("VmRSS:") || line.starts_with("VmHWM:") || line.starts_with("VmSwap:") {
+            let (key,value) = line.split_once(':').unwrap();
+            result.insert(key.to_owned(), json!(value.split_whitespace().next().unwrap().parse::<u64>().unwrap()*1024));
+        }
+    }
+    Value::Object(result)
+}
+pub(crate) fn snapshot(label: &str, rules: usize) -> Value {
+    json!({"label":label,"rules":rules,"memory":memory(),
+      "baseline_payload_live":LIVE_BYTES.load(Relaxed),"baseline_payload_peak":LIVE_PEAK.load(Relaxed),
+      "allocated_count":values(&ALLOC_COUNT),"allocated_bytes":values(&ALLOC_BYTES),
+      "retired_count":values(&FREE_COUNT),"retired_bytes":values(&FREE_BYTES),
+      "policy_payload_current":values(&POLICY_CURRENT),"policy_payload_peak":values(&POLICY_PEAK)})
+}
+pub(crate) fn summary() -> Value {
+    json!({"capacity_bounds":BOUNDS,"birth_slots":BIRTH_SLOTS.load(Relaxed),
+      "grows":GROWS.load(Relaxed),"physical_rewrites":REWRITES.load(Relaxed),"retired_age_counts":values(&RETIRED_AGES),
+      "retired_byte_age_sums":values(&RETIRED_BYTE_AGES),
+      "chosen_bytes":values(&CHOSEN_BYTES),"floor_bytes":values(&FLOOR_BYTES),
+      "retired_age_bucket_upper_bounds_rules":[0,1,3,7,15,31,63,127,255,511,1023,2047,4095,8191,16383,32767,null]})
+}
